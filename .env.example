# API environment variables
DATABASE_URL=postgresql://postgres:password@localhost:5432/bundleup_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bundleup_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# Web environment variables (prefix with VITE_ to expose to browser)
VITE_API_URL=http://localhost:3001/api
