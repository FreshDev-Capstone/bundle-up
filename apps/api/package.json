{
  "name": "@bundle-up/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "db:migrate": "knex --knexfile src/config/knexfile.ts migrate:latest",
    "db:rollback": "knex --knexfile src/config/knexfile.ts migrate:rollback",
    "db:seed": "knex --knexfile src/config/knexfile.ts seed:run",
    "db:migrate:make": "knex --knexfile src/config/knexfile.ts migrate:make"
  },
  "dependencies": {
    "@bundle-up/shared-types": "*",
    "@bundle-up/utils": "*",
    "@bundle-up/validation": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@bundle-up/config-eslint": "*",
    "@bundle-up/config-typescript": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
